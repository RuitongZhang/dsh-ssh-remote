{
  "name": "dsh-ssh-remote",
  "version": "1.0.0",
  "private": true,
  "description": "Read, edit, search, and run commands on a remote Linux host over SSH.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
